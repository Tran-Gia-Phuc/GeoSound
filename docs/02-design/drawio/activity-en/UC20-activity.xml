        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.1. The Admin chooses &quot;Dismiss reports&quot; and confirms &quot;Dismiss the reports?&quot; when the tour has open reports." vertex="1">
