        <mxCell id="11" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="8. The system (Tour) checks whether the position is inside a forbidden zone. E2." vertex="1">
