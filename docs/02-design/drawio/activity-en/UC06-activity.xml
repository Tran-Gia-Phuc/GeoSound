        <mxCell id="11" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Not signed in → 401 &quot;You need to sign in to report this tour.&quot;" vertex="1">
