        <mxCell id="12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. No reason chosen → &quot;Please choose a report reason&quot;; &quot;Other&quot; without a note → &quot;Please describe the reason&quot;." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="498" as="geometry" />
