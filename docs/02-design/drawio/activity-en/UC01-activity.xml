        </mxCell>
        <mxCell id="3" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="0" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. The actor opens the &quot;Sign in&quot; page (without an account, chooses &quot;Sign up&quot;). A1." vertex="1">
          <mxGeometry height="130" width="320" x="-160" y="90" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. The system shows a form with Email, Password and a &quot;Forgot password&quot; link. A2." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="280" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="3. The actor enters the email and password and taps &quot;Sign in&quot;. E1." vertex="1">
          <mxGeometry height="115" width="320" x="-160" y="415" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="4. The system sends the sign-in request with the device identifier (deviceId)." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="590" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. The system (Auth) normalises the email, checks the account status and matches the password (bcrypt). E2, E3, E4." vertex="1">
          <mxGeometry height="145" width="320" x="-160" y="725" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="6. The system creates a sign-in session for the device and returns the access token and refresh token; for a new device it sends a sign-in alert (UC#23)." vertex="1">
          <mxGeometry height="120" width="220" x="-110" y="930" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="7. The system redirects: to the page in the ?next= parameter if present; otherwise Contributor → Studio, Tourist and Admin → home page." vertex="1">
          <mxGeometry height="105" width="220" x="-110" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="1305" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Invalid email format → &quot;Invalid email&quot;." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="90" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Weak password → &quot;Password must have at least 8 characters&quot; / &quot;Password must contain both letters and digits&quot;." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="180" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E7. Email already has an account → &quot;The account is already registered&quot; (409)." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="300" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E8. Wrong OTP → &quot;Invalid OTP, please try again&quot;." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="405" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E9. OTP expired → &quot;The verification session has expired, please start again&quot; (410)." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="495" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Empty field → &quot;Please enter your email&quot; / &quot;Please enter your password&quot;." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="600" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Wrong email or password → &quot;Incorrect email or password&quot;; after 5 failures in a row, sign-in for the account is locked for 15 minutes (423)." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="705" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. The account is banned → &quot;The account has been locked, please contact the Admin&quot;." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="840" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Account temporarily suspended (suspended, UC#21) → &quot;The account is suspended until &lt;time date&gt;&quot;." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="945" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.1. The Actor chooses &quot;Sign up&quot; and picks the account type (Tourist / Contributor)." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="250" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. The system shows the form: Full name, Email, Password, Confirm password." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="375" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.3. The actor enters the information and taps &quot;Continue&quot;. E5, E6." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="500" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.4. The system checks the email is not registered yet, stores the sign-up data temporarily (Redis) and sends a 6-digit OTP code by email. E7." vertex="1">
          <mxGeometry height="105" width="220" x="-510" y="625" as="geometry" />
        </mxCell>
        <mxCell id="25" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.5. The actor enters the OTP code. A3." vertex="1">
          <mxGeometry height="60" width="220" x="-510" y="780" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.6. The system verifies the OTP, creates the account, signs the user in and redirects by role. E8, E9." vertex="1">
          <mxGeometry height="90" width="220" x="-510" y="890" as="geometry" />
        </mxCell>
        <mxCell id="27" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.1. The actor chooses &quot;Forgot password&quot; and enters the email." vertex="1">
          <mxGeometry height="75" width="220" x="-910" y="385" as="geometry" />
        </mxCell>
        <mxCell id="28" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.2. The system always returns the same message (it does not reveal whether the email exists); if the account exists, it sends an OTP code by email." vertex="1">
          <mxGeometry height="105" width="220" x="-910" y="510" as="geometry" />
        </mxCell>
        <mxCell id="29" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.3. The Actor enters the OTP and a new password. A3, E6." vertex="1">
          <mxGeometry height="60" width="220" x="-910" y="665" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.4. The system verifies the OTP, changes the password and signs out every signed-in device; the Actor signs in again with the new password. E8, E9." vertex="1">
          <mxGeometry height="105" width="220" x="-910" y="775" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3.1. The actor taps &quot;Resend OTP&quot; (enabled only after 30 seconds)." vertex="1">
          <mxGeometry height="75" width="220" x="-1310" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3.2. The system sends a new code (the old code stops working) and extends the validity by another 120 seconds." vertex="1">
          <mxGeometry height="90" width="220" x="-1310" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4. The access token expires during use: the client refreshes the session with the refresh token (the token is rotated) and resends the request; if the refresh fails, it goes back to the Sign in page." vertex="1">
          <mxGeometry height="135" width="220" x="-1710" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A5. Change the password while signed in: Account → &quot;Change password&quot;, enter the current password and the new password (at least 8 characters, letters and digits, different from the old one)." vertex="1">
          <mxGeometry height="135" width="220" x="-2110" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A6. Sign out: the system revokes the current device's session and deletes the tokens on the device." vertex="1">
          <mxGeometry height="90" width="220" x="-2510" y="1245" as="geometry" />
        </mxCell>
