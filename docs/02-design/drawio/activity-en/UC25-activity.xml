        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Not signed in → &quot;You need to sign in to buy a tour.&quot; and a &quot;Sign in&quot; button (UC#01); the API returns 401." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="315" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. The tour is no longer public → 404 &quot;The tour is no longer available&quot;; the price has changed → 409 &quot;The tour price has changed, please check again&quot;." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="773" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. This tour is already bought → 409 &quot;You have already bought this tour&quot;; a pending order exists → its URL is returned again." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="908" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. The Tourist is the author → 403 &quot;You do not need to buy your own tour&quot;." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="1028" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Payment fails (card declined, insufficient balance, wrong OTP) → the order is failed, &quot;Payment unsuccessful&quot; with a &quot;Try again&quot; button." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="1133" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Wrong signature → RspCode 97, the order is not changed; wrong amount → RspCode 04, the order is failed; unknown order code → RspCode 01." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="1298" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E7. IPN resent for an order already paid → RspCode 02, no access is granted and no email is sent again." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1433" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E8. No IPN yet → &quot;Confirming payment…&quot;, asks again every 3 seconds for 1 minute; on timeout → &quot;No confirmation received yet. The result will appear in Notifications.&quot;" vertex="1">
          <mxGeometry height="105" width="250" x="355" y="1553" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1. The tour is already bought, or the Tourist is the author / Admin: shows &quot;Purchased&quot; and the &quot;Start listening&quot; button, as for a free tour." vertex="1">
          <mxGeometry height="105" width="220" x="-510" y="195" as="geometry" />
