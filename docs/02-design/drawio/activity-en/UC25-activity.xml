        <mxCell id="8" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. The Tourist presses &quot;Pay with MoMo&quot;." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="860" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="6. The system creates a &quot;Pending&quot; order (amount = current price), asks MoMo to create a payment signed with HMAC SHA256 and returns the payment link. E2, E3, E4." vertex="1">
          <mxGeometry height="175" width="320" x="-160" y="980" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="7. The browser goes to the MoMo payment page." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="1215" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="8. The Tourist pays on the MoMo page (wallet, ATM or a sandbox test card). A4." vertex="1">
          <mxGeometry height="115" width="320" x="-160" y="1335" as="geometry" />
