        <mxCell id="3" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="0" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Người dùng vào Tài khoản → “Thiết bị đang đăng nhập”." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="90" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Hệ thống (Auth) trả các phiên còn hiệu lực: tên thiết bị (vd “Chrome trên Windows”), vị trí, thời điểm đăng nhập, hoạt động gần nhất." vertex="1">
          <mxGeometry height="105" width="220" x="-110" y="210" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="3. Hệ thống hiển thị thiết bị hiện tại đầu tiên với nhãn “Thiết bị này”, các thiết bị khác theo hoạt động gần nhất. E1, E4." vertex="1">
          <mxGeometry height="145" width="320" x="-160" y="375" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="4. Người dùng nhấn “Đăng xuất thiết bị” ở một thiết bị khác. A1, A2." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="580" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. Hệ thống hỏi “Đăng xuất khỏi &lt;tên thiết bị&gt;?”." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="715" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="6. Người dùng xác nhận." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="835" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="7. Hệ thống thu hồi phiên, ghi khóa thu hồi vào Redis, bỏ dòng đó khỏi danh sách và báo “Đã đăng xuất &lt;tên thiết bị&gt;”. E2, E3." vertex="1">
          <mxGeometry height="145" width="320" x="-160" y="955" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="8. Trên thiết bị bị đăng xuất, yêu cầu kế tiếp bị từ chối (401); client xóa token và chuyển tới Đăng nhập với thông báo “Phiên đăng nhập đã kết thúc trên thiết bị này”." vertex="1">
          <mxGeometry height="175" width="320" x="-160" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Chỉ có thiết bị hiện tại → ẩn nút “Đăng xuất tất cả thiết bị khác”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="363" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Không tải được danh sách → “Chưa tải được danh sách thiết bị” kèm nút Thử lại." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="468" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Thiết bị đã đăng xuất / hết hạn hoặc không phải của mình → 404; client báo “Thiết bị này đã đăng xuất” và tải lại danh sách." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="928" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Mất mạng → “Không thể kết nối, vui lòng thử lại”; phiên của thiết bị kia không đổi." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="1048" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Không phải Admin xem thiết bị online → 403." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1178" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Mã thiết bị sai định dạng → 400; token sai hoặc hết hạn → 401." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E7. Redis không phản hồi → tín hiệu online bị bỏ qua (vẫn trả 204); Admin chỉ thấy số thiết bị đã đăng nhập kèm ghi chú." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1358" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.1. Người dùng nhấn “Đăng xuất tất cả thiết bị khác” và xác nhận." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="685" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Hệ thống thu hồi mọi phiên trừ phiên hiện tại; danh sách chỉ còn “Thiết bị này”; báo “Đã đăng xuất n thiết bị”." vertex="1">
          <mxGeometry height="90" width="220" x="-510" y="810" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2. Đăng xuất thiết bị đang dùng: nút “Đăng xuất” ở trang Tài khoản thu hồi phiên hiện tại (UC#01 A6)." vertex="1">
          <mxGeometry height="90" width="220" x="-910" y="685" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3. Hệ thống tự đăng xuất: đặt lại mật khẩu (mọi thiết bị), đổi mật khẩu (trừ thiết bị hiện tại), tạm khóa / cấm (mọi thiết bị, UC#21), quá 7 ngày không hoạt động hoặc 30 ngày từ lúc đăng nhập, refresh token cũ bị dùng lại, vượt 100 phiên." vertex="1">
          <mxGeometry height="150" width="220" x="-1310" y="1365" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4. Cảnh báo thiết bị mới: đăng nhập trên thiết bị chưa từng có phiên → Auth phát auth.new_device_login, Notification gửi email “Đăng nhập mới trên &lt;thiết bị&gt;”." vertex="1">
          <mxGeometry height="120" width="220" x="-1710" y="1365" as="geometry" />
        </mxCell>
        <mxCell id="25" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A5.1. Mọi client (đăng nhập hay chưa) gửi tín hiệu online mỗi 60 giây khi tab hiển thị hoặc audio đang phát, và gửi tín hiệu rời khi đóng trang. E6, E7." vertex="1">
          <mxGeometry height="120" width="220" x="-2110" y="1365" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A5.2. Admin mở trang “Thiết bị online”." vertex="1">
          <mxGeometry height="60" width="220" x="-2110" y="1535" as="geometry" />
        </mxCell>
        <mxCell id="27" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A5.3. Hệ thống hiển thị số thiết bị đang online (đã đăng nhập và khách), tài khoản online, phiên đang đăng nhập, thiết bị truy cập hôm nay / 7 / 30 ngày và bảng thiết bị đã đăng nhập đang online; tự làm mới mỗi 30 giây. E5." vertex="1">
          <mxGeometry height="150" width="220" x="-2110" y="1645" as="geometry" />
        </mxCell>
