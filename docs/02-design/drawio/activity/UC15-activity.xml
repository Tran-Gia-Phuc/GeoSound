        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Tour đang ở chế độ Truy cập hạn chế (UC#14) hoặc bị Admin ẩn → 409." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="565" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Không phải tác giả → 403; tour không tồn tại → 404." vertex="1">
