        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Thiếu điều kiện bắt buộc → 422 “Tour chưa đủ điều kiện xuất bản” kèm danh sách mục chưa đạt và liên kết tới chỗ cần sửa." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="325" as="geometry" />
