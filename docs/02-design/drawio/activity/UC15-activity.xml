        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E8. Client hỏi trạng thái thất bại → “Chưa cập nhật được trạng thái: …” và nút “Thử lại”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="880" as="geometry" />
