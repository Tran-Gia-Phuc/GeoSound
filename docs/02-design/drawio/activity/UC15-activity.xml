        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Còn điểm đang kiểm duyệt / bị AI từ chối, hoặc quá 50 điểm → mục tương ứng trong checklist không đạt." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="445" as="geometry" />
