        <mxCell id="12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="9. Pass: Tour chuyển tour sang “Chờ duyệt” và đưa vào hàng chờ Admin." vertex="1">
