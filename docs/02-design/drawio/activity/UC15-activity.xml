          <mxGeometry height="60" width="220" x="-110" y="225" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="3. Hệ thống (Tour) kiểm tra điều kiện: đủ thông tin, mọi điểm có mô tả, không điểm nào đang kiểm duyệt hoặc bị AI từ chối, tối đa 50 điểm. E1, E2, E3, E4." vertex="1">
