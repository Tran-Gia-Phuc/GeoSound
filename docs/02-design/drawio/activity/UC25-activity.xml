        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E7. IPN gửi lại cho đơn đã paid → RspCode 02, không cấp quyền hay gửi email lần nữa." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="1365" as="geometry" />
