        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Thanh toán thất bại (thẻ bị từ chối, không đủ số dư, sai OTP) → đơn failed, “Thanh toán không thành công” kèm nút “Thử lại”." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1073" as="geometry" />
