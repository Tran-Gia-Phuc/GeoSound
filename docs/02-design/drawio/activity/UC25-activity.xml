        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Sai chữ ký → RspCode 97, không đổi đơn; sai số tiền → RspCode 04, đơn failed; mã đơn không tồn tại → RspCode 01." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1245" as="geometry" />
