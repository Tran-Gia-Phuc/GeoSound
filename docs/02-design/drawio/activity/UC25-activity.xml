        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Giá không hợp lệ (âm, lẻ, dưới 1 000 hoặc trên 50 000 000) → 400; không phải tác giả → 403." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="90" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Tour miễn phí → 400; tác giả tự mua tour của mình → 400; tour không còn công khai → 404." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="885" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Đã mua rồi → 409; client tải lại trạng thái và hiện mục tải về." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="990" as="geometry" />
