        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Chưa cấu hình khóa MoMo, hoặc MoMo từ chối / không phản hồi → 503 “Thanh toán MoMo đang tạm thời không khả dụng”; đơn thành “Thất bại”." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="1080" as="geometry" />
