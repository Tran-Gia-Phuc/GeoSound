        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Tải gói tour có phí khi chưa đăng nhập → 401; đã đăng nhập nhưng chưa mua → 402." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="2035" as="geometry" />
