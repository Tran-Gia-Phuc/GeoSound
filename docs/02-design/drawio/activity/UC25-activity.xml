        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Chưa đăng nhập → “Bạn cần đăng nhập để mua tour.” và nút “Đăng nhập” (UC#01); API trả 401." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="315" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Tour không còn công khai → 404 “Tour không còn khả dụng”; giá đã đổi → 409 “Giá tour đã thay đổi, vui lòng xem lại”." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="743" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Đã mua tour này → 409 “Bạn đã mua tour này”; đang có đơn pending → trả lại URL của đơn đó." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="863" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Tourist là tác giả → 403 “Bạn không cần mua tour của chính mình”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="968" as="geometry" />
