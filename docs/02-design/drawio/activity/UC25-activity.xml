        <mxCell id="25" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1. Tour miễn phí (giá 0): không có khung mua, mục “Tải về để nghe offline” như UC#03." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="740" as="geometry" />
