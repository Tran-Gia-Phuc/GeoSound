        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. IPN sai chữ ký, sai partnerCode hoặc sai số tiền → 400, đơn không đổi; đơn không tồn tại → 404." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="1385" as="geometry" />
