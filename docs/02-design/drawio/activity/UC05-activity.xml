        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Tourist mở mục “Đánh giá” trên chi tiết tour, hoặc bấm nút đánh giá ở hộp kết thúc của trình phát (UC04)." vertex="1">
