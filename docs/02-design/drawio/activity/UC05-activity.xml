        <mxCell id="6" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="3. Client kiểm tra đánh giá của Tourist; đã đăng nhập, không phải tác giả, chưa đánh giá? E1, E4, A1, A2." vertex="1">
