        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Author chọn lý do và nhập giải trình chi tiết; hệ thống gắn nhãn ưu tiên (reporter_role = 'AUTHOR')." vertex="1">
