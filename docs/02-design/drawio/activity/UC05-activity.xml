        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Author chọn lý do và nhập giải trình chi tiết (tùy chọn); server lưu reporter_role = 'AUTHOR', hàng đợi Admin hiện nhãn “Khiếu nại từ Tác giả”." vertex="1">
