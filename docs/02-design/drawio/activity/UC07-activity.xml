        <mxCell id="25" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3.1. Tourist chọn “Tải về để nghe offline” (chỉ chủ sở hữu)." vertex="1">
          <mxGeometry height="75" width="220" x="-1310" y="1755" as="geometry" />
