        <mxCell id="24" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.3. Đổi tên lịch trình hoặc xóa cả lịch trình." vertex="1">
          <mxGeometry height="60" width="220" x="-910" y="1650" as="geometry" />
