        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Hệ thống tải lại danh sách (tối đa 50 mỗi trang)." vertex="1">
          <mxGeometry height="60" width="220" x="-510" y="290" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.1. Đổi thứ tự bằng nút lên / xuống → đánh lại thứ tự, tính lại quãng đường." vertex="1">
          <mxGeometry height="75" width="220" x="-910" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.2. Bỏ một điểm ngay, thông báo có nút “Hoàn tác”." vertex="1">
