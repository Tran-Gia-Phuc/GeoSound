        <mxCell id="2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;UC12&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="-2510" y="-110" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="0" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Contributor mở bước “Ngôn ngữ”." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="90" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Hệ thống hiển thị ngôn ngữ gốc, các ngôn ngữ phụ đã chọn, giọng đọc, bản dịch từng điểm và tiến độ (“n/n điểm đã dịch”)." vertex="1">
          <mxGeometry height="105" width="220" x="-110" y="210" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="3. Contributor chọn các ngôn ngữ phụ và giọng (nam / nữ, vùng miền tùy chọn), nhấn “Lưu &amp; tạo bản dịch”." vertex="1">
          <mxGeometry height="90" width="220" x="-110" y="375" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="4. Hệ thống chuẩn hóa danh sách ngôn ngữ (bỏ trùng, bỏ ngôn ngữ gốc) và xóa ngôn ngữ bị gỡ cùng bản dịch của nó." vertex="1">
          <mxGeometry height="90" width="220" x="-110" y="525" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. Hệ thống dịch theo lô qua AI (tối đa 20 đoạn mỗi lần gọi), chỉ dịch điểm chưa có bản dịch hoặc bản dịch đã cũ; bản chỉnh tay được giữ. E1." vertex="1">
          <mxGeometry height="160" width="320" x="-160" y="675" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="6. Hệ thống lưu bản dịch của mọi điểm theo mọi ngôn ngữ và trả cấu hình mới." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="895" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="7. Contributor chọn tab một ngôn ngữ phụ và nghe thử một điểm. A1." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="8. Contributor sửa bản dịch sai (tên riêng, thuật ngữ) và lưu dòng đó. A2." vertex="1">
          <mxGeometry height="115" width="320" x="-160" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="-20" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. AI dịch lỗi (timeout, 5xx, sai số lượng bản dịch) → 503 “Dịch tự động thất bại, vui lòng thử lại”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="670" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Mã ngôn ngữ ngoài tập hỗ trợ → 400 “Ngôn ngữ không hỗ trợ: xx”; sửa bản ngôn ngữ chưa cấu hình → 400 “Ngôn ngữ chưa được cấu hình cho tour”; sửa ngôn ngữ gốc → sửa ở UC#10." vertex="1">
          <mxGeometry height="120" width="250" x="355" y="1093" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Trình duyệt không phát được → “Không phát được bản nghe thử. Nội dung bản dịch vẫn được giữ; bạn có thể thử lại.”" vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1243" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1. Nghe thử: hệ thống đọc bản dịch bằng giọng của thiết bị (Web Speech), nhãn “Nghe thử bằng giọng trên thiết bị · chưa có tệp âm thanh”. E3." vertex="1">
          <mxGeometry height="105" width="220" x="-510" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2. Chỉnh bản dịch: bản dịch được đánh dấu “đã chỉnh tay” và được giữ ở các lần lưu sau. E2." vertex="1">
          <mxGeometry height="90" width="220" x="-910" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3. Gỡ một ngôn ngữ phụ: hệ thống xóa ngôn ngữ và các bản dịch của nó." vertex="1">
          <mxGeometry height="75" width="220" x="-1310" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4. Mô tả gốc đổi (UC#10): hệ thống dịch lại điểm đó; bản chỉnh tay được giữ nhưng gắn chip “Cần xem lại”." vertex="1">
          <mxGeometry height="90" width="220" x="-1710" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A5. Khách yêu cầu dịch tự động ngôn ngữ chưa bật (UC#04 A7): bản dịch được lưu riêng, hiển thị ở bước Ngôn ngữ; tác giả bật ngôn ngữ đó thì dùng lại bản dịch, không gọi AI lại." vertex="1">
          <mxGeometry height="120" width="220" x="-2110" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A6. Công tắc “Cho khách yêu cầu dịch tự động”: tắt thì khách không yêu cầu được ngôn ngữ ngoài danh sách và các bản dịch tự động đã có bị ẩn." vertex="1">
