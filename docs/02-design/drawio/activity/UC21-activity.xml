        <mxCell id="5" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Auth trả danh sách tài khoản (mới nhất trước, 20 / trang, tối đa 50) kèm vai trò, trạng thái, lý do cấm, hạn tạm khóa; hợp lệ? A3, E2." vertex="1">
