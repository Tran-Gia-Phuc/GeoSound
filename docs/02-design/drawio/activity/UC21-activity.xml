        <mxCell id="9" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="6. Auth kiểm tra quy tắc (không tự xử lý, không xử lý admin, chưa bị cấm); được phép? E3, E4/E5." vertex="1">
