        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Xử lý chính mình → 403 “Không thể xử lý chính tài khoản của bạn”; tài khoản đích là Admin → 403." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="985" as="geometry" />
