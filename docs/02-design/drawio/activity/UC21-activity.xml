        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Trạng thái vừa bị Admin khác đổi → 409 “Trạng thái tài khoản vừa được thay đổi, vui lòng tải lại”." vertex="1">
