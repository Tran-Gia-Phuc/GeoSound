        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Admin mở trang “Người dùng”, tìm theo email hoặc họ tên, lọc theo vai trò / trạng thái." vertex="1">
