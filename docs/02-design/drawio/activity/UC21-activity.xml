        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Admin mở trang “Tài khoản”, tìm theo email hoặc tên, lọc theo vai trò và trạng thái." vertex="1">
