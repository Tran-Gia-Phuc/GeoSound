        <mxCell id="5" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Hệ thống trả danh sách tài khoản (20 mục mỗi trang). E2." vertex="1">
          <mxGeometry height="115" width="320" x="-160" y="225" as="geometry" />
