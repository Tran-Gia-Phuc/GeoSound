        </mxCell>
        <mxCell id="7" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="4. Auth trả thông tin và số phiên đang hoạt động; Tour trả lịch sử vi phạm (tour bị ẩn / từ chối, số báo cáo, 20 hành động gần nhất); tồn tại? E1." vertex="1">
          <mxGeometry height="160" width="320" x="-160" y="565" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. Admin chọn Cảnh báo, Tạm khóa (1, 7, 30 ngày hoặc ngày kết thúc) hoặc Cấm, nhập lý do, xác nhận; hợp lệ? A1, A2, E6." vertex="1">
          <mxGeometry height="145" width="320" x="-160" y="785" as="geometry" />
