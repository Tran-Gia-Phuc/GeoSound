        <mxCell id="8" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="5. Admin chọn “Duyệt” và xác nhận “Duyệt tour này?”? A2, A3." vertex="1">
