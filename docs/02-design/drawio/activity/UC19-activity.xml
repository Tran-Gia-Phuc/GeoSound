        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Không có tour chờ duyệt → “Không có tour nào chờ duyệt”." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="235" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Không có token hợp lệ → 401; không phải Admin → 403, client hiện “Chỉ quản trị viên được xem trang này”." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="325" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Mã tour sai định dạng → 400; tour không tồn tại → 404, client hiện “Không tìm thấy tour này”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="598" as="geometry" />
