        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2. Cuộc trò chuyện mới: Tourist chọn “Cuộc trò chuyện mới”; câu hỏi sau tạo phiên mới." vertex="1">
          <mxGeometry height="75" width="220" x="-910" y="370" as="geometry" />
