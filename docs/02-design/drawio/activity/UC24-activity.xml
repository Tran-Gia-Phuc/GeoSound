        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Tourist bấm nút nổi “Hỏi trợ lý” hoặc mở trang Chat. A1." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="90" as="geometry" />
