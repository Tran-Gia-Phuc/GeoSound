        <mxCell id="5" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Hệ thống kiểm tra chatbot đang bật và tải lịch sử của phiên chat hiện tại (nếu có). E1, A2." vertex="1">
          <mxGeometry height="130" width="320" x="-160" y="210" as="geometry" />
