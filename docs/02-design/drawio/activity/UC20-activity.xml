        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Trạng thái không cho phép (ẩn tour không công khai, khôi phục tour không bị ẩn, bỏ qua khi không còn báo cáo mở) → 409; hai Admin cùng xử lý thì chỉ một người thắng." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="970" as="geometry" />
