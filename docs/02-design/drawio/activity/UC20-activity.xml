        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Hệ thống chuyển tour về Công khai (không duyệt lại), ghi log restore_tour, phát tour.restored; tác giả nhận thông báo và email “Tour … đã được hiển thị lại”. E4." vertex="1">
          <mxGeometry height="120" width="220" x="-510" y="1100" as="geometry" />
