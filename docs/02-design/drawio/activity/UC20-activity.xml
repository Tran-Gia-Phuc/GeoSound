        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2.1. Admin chọn “Bỏ qua báo cáo” khi tour có báo cáo đang mở." vertex="1">
