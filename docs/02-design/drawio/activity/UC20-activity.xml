        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.1. Admin mở tour đang bị ẩn và chọn “Hiển thị lại” (lý do tùy chọn)." vertex="1">
          <mxGeometry height="75" width="220" x="-510" y="975" as="geometry" />
