        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Phát sự kiện thất bại chỉ được ghi log; quyết định vẫn được lưu." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1228" as="geometry" />
