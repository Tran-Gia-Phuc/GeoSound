        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Không có token hợp lệ → 401; không phải Admin → 403; tham số phân trang sai → 400." vertex="1">
