        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. Auth kiểm tra (E5–E7: email sai định dạng, mật khẩu yếu, email đã có), giữ thông tin tạm và gửi OTP 6 số qua email." vertex="1">
