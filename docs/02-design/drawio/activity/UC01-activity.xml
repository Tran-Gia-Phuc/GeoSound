        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.1. Người dùng chọn “Đăng ký”, chọn vai trò (Khách du lịch / Tác giả), nhập họ tên, email, mật khẩu." vertex="1">
