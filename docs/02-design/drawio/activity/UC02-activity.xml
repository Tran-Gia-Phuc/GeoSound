        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="10. Tourist chọn “Nghe thử” hoặc “Bắt đầu đi tour” ở thanh hành động dưới." vertex="1">
