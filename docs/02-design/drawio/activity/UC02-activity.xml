        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Tourist mở app (màn “Khám phá”)." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="90" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="2. Client hiện ô tìm kiếm, tab Tour / Địa điểm, chip thành phố, “Gần bạn”, “Mở gần đây” và danh sách “Phổ biến”." vertex="1">
