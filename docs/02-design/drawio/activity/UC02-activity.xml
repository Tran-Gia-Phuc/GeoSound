        <mxCell id="11" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="8. Tourist chọn ngôn ngữ nghe." vertex="1">
          <mxGeometry height="60" width="220" x="-110" y="1175" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="9. Tour trả chi tiết theo ngôn ngữ đó: text từng điểm, audio và nhãn giọng mới." vertex="1">
          <mxGeometry height="75" width="220" x="-110" y="1295" as="geometry" />
