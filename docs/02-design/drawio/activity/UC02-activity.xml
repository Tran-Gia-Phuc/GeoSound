        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4.2. Chạm thẻ mở chi tiết (mô tả, ảnh, nghe thử); nút “＋” thêm điểm vào lịch trình (UC07, cần đăng nhập)." vertex="1">
          <mxGeometry height="90" width="220" x="-510" y="470" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.1. Tourist chọn sắp xếp “Phổ biến”, “Đánh giá cao”, “Mới nhất” hoặc “Gần tôi”." vertex="1">
          <mxGeometry height="75" width="220" x="-910" y="465" as="geometry" />
