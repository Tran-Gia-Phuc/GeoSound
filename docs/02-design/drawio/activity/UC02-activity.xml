        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1.2. “Gần tôi” xin quyền vị trí, xếp theo khoảng cách tới điểm đầu tour; không có quyền vị trí → không sắp theo khoảng cách (E4)." vertex="1">
          <mxGeometry height="105" width="220" x="-910" y="590" as="geometry" />
