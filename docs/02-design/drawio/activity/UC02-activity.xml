        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4.1. Tourist chuyển sang tab “Địa điểm”; client tìm các địa điểm công khai theo từ khoá, thành phố, loại, vị trí." vertex="1">
