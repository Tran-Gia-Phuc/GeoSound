        <mxCell id="4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="1. Tác giả mở bước Xuất bản, khung “Truy cập hạn chế”." vertex="1">
