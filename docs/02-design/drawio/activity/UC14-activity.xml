        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Passcode không hợp lệ → “Vui lòng nhập mã truy cập” / “Mã truy cập phải từ 6 đến 32 ký tự”, không chứa khoảng trắng." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="325" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Trạng thái không cho bật (Công khai, đang kiểm duyệt, Chờ duyệt, Đang ẩn) → 409; không phải tác giả → 403." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="445" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Gửi duyệt tour đang hạn chế → 409 “... hãy tắt chế độ này trước khi gửi duyệt”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="680" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3/E4. Sai mã → “Mã truy cập không đúng”; sai quá 5 lần trong 15 phút → “... thử lại sau 15 phút” (kể cả khi mã đúng)." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1263" as="geometry" />
