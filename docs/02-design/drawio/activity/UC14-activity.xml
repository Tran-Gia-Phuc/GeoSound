        <mxCell id="13" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Tour không ở trạng thái cho phép bật hạn chế → 409; không phải tác giả → 403; tắt khi tour không hạn chế → 409." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="198" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E1. Passcode trống → “Vui lòng nhập mã truy cập”; có khoảng trắng → “Mã truy cập không được chứa khoảng trắng”; độ dài sai → “Mã truy cập phải từ 6 đến 32 ký tự” (400)." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="380" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Passcode sai → 403 “Mã truy cập không đúng”." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1073" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Sai quá 5 lần trong 15 phút → 429 “Bạn đã nhập sai quá nhiều lần, vui lòng thử lại sau 15 phút”." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="1163" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Tour không tồn tại hoặc không ở trạng thái Hạn chế → 404." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Gửi duyệt hoặc xuất bản khi tour đang hạn chế → 409." vertex="1">
          <mxGeometry height="60" width="250" x="355" y="1358" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1. Đổi passcode: Contributor nhập passcode mới; hệ thống tăng phiên bản và xóa mọi quyền truy cập cũ, người thử nghiệm phải nhập lại." vertex="1">
          <mxGeometry height="105" width="220" x="-510" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A2. Tắt truy cập hạn chế: Contributor nhấn “Tắt”; hệ thống chuyển tour về Nháp và xóa mọi quyền truy cập. E2." vertex="1">
          <mxGeometry height="90" width="220" x="-910" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A3. Sửa nội dung tour khi đang hạn chế: tour vẫn ở “Hạn chế”, người thử nghiệm thấy nội dung mới." vertex="1">
          <mxGeometry height="90" width="220" x="-1310" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4. Muốn công khai: Contributor tắt truy cập hạn chế trước rồi gửi duyệt (UC#15). E6." vertex="1">
