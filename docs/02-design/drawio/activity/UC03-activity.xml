        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E4. Mất mạng giữa chừng → “Mất kết nối mạng. Phần đã tải được giữ lại.”" vertex="1">
          <mxGeometry height="75" width="250" x="355" y="763" as="geometry" />
