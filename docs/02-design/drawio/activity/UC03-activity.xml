        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A1. Tạm dừng / tiếp tục / hủy tải: phần đã tải được giữ, gói bị gián đoạn hiện “Bị gián đoạn” và tải tiếp từ tệp còn thiếu." vertex="1">
          <mxGeometry height="105" width="220" x="-510" y="950" as="geometry" />
