        <mxCell id="26" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="A4.2. Client tải lại gói, giữ các tệp không đổi, chỉ tải tệp mới; gói chưa sẵn sàng cho tới khi đủ tệp." vertex="1">
