        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E2. Tour không còn công khai (404) hoặc ngôn ngữ chưa có bản dịch (400) → báo lỗi, không tải." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="375" as="geometry" />
