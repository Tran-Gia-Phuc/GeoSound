        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E6. Chưa có tour nào → danh sách trống; trình duyệt chặn IndexedDB → báo không dùng được tính năng offline." vertex="1">
          <mxGeometry height="90" width="250" x="355" y="1380" as="geometry" />
