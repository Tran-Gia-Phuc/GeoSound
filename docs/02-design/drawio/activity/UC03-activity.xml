        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E7. Tour có phí (UC#25) mà khách chưa mua → khung “Mua tour để tải về” thay cho mục tải; gọi thẳng manifest: 401 (chưa đăng nhập) hoặc 402 (chưa mua)." vertex="1">
          <mxGeometry height="105" width="250" x="355" y="480" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E3. Không đủ chỗ → “Không đủ dung lượng trên thiết bị.”" vertex="1">
          <mxGeometry height="60" width="250" x="355" y="615" as="geometry" />
