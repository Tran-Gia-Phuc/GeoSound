        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;" value="E5. Một tệp lỗi → gói ở trạng thái lỗi, nút “Thử lại” tải lại các tệp còn thiếu." vertex="1">
          <mxGeometry height="75" width="250" x="355" y="868" as="geometry" />
