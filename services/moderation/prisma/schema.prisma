// Moderation service: schema "moderation". One row per moderation case (task #AI-33).
// Design: docs/02-design/moderation-architecture.md section 7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // ...?schema=moderation
}

// One case = one (subjectType, subjectId, revision). Duplicate events reuse the same row (D10).
model ModerationCase {
  id          String    @id @default(uuid())
  subjectType String    @map("subject_type") // place | tour
  subjectId   String    @map("subject_id")
  tourId      String?   @map("tour_id")
  revision    String // Tour's updatedAt, echoed back in results
  status      String    @default("pending") // pending | reviewing | done | ai_failed | failed_permanent
  verdict     String? // Pass | Warning | Reject
  severity    Float?
  reasons     Json      @default("[]")
  attempts    Int       @default(0)
  model       String?
  lastError   String?   @map("last_error")
  payload     Json // original event payload, used by the sweeper to retry
  publishedAt DateTime? @map("published_at")
  checkedAt   DateTime? @map("checked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, revision])
  @@index([status, updatedAt])
  @@map("moderation_cases")
}
