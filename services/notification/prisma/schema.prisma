// Notification service — schema "notification". Lưu thông báo in-app.
// Data model chi tiết: tech-stack.md §11.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // ...?schema=notification
}

// --- Placeholder (sẽ thay khi chốt data model) ---
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
