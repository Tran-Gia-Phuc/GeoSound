// Media service — schema "media". Metadata asset audio TTS đã render.
// Data model chi tiết: tech-stack.md §11.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // ...?schema=media
}

// --- Placeholder (sẽ thay khi chốt data model) ---
model AudioAsset {
  id        String   @id @default(uuid())
  tourId    String
  lang      String
  s3Url     String
  kind      String   @default("tts") // tts | human
  createdAt DateTime @default(now())

  @@map("audio_assets")
}
