PORT=3004
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=10
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=geosound.events
TOUR_SERVICE_URL=http://tour:3002
DATABASE_URL=postgresql://user:password@postgres:5432/geosound
JWT_ACCESS_SECRET=
MODERATION_REJECT_THRESHOLD=0.8
MODERATION_WARNING_THRESHOLD=0.4
MODERATION_TIMEOUT_SECONDS=30
MODERATION_MAX_CONCURRENCY=2
# Shared secret Moderation -> AI (header x-internal-token). Set a long random value.
INTERNAL_SERVICE_TOKEN=
# Phase 2: comma-separated image hosts; empty = host of SUPABASE_URL.
IMAGE_ALLOWED_HOSTS=
# Only the host is used (image allowlist when IMAGE_ALLOWED_HOSTS is empty).
SUPABASE_URL=
# Max bytes per image (3 MB) and total fetch time per image, in seconds.
IMAGE_MAX_BYTES=3145728
IMAGE_FETCH_TIMEOUT_SECONDS=10
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=geosound-ai
# Chatbot: user turns kept per session and sent to the LLM.
CHAT_MEMORY_TURNS=6
# Chatbot indexer (consumes tour.published / tour.unpublished). Off by default.
CHATBOT_INDEXER_ENABLED=false
CHATBOT_INDEXER_QUEUE=ai.chatbot-indexer
CHATBOT_INDEXER_MAX_RETRIES=3
CHATBOT_INDEXER_RETRY_DELAY_SECONDS=5
# Chat API (/chat, /chat/history). Off by default: both routes answer 404.
CHATBOT_ENABLED=false
# LLM-backed chat turns per minute on Gemini across all users; overflow runs on Groq (429 without GROQ_API_KEY).
CHAT_GLOBAL_RATE_LIMIT_PER_MIN=2
# Idle chat sessions are deleted after this many hours.
CHAT_SESSION_TTL_HOURS=24
CHAT_MESSAGE_MAX_CHARS=1000
# Chatbot index (schema ai, pgvector on Supabase); see the root .env.example.
DATABASE_URL_AI=
# Session pooler URL of the same database: prisma db push and the Postgres chat memory.
DATABASE_URL_DIRECT_AI=
# Chat memory: memory = in this process (default); postgres = schema ai_chat, needs DATABASE_URL_DIRECT_AI.
CHAT_MEMORY_BACKEND=memory
# Chatbot embeddings: local = ONNX multilingual-e5-small baked into the image (fake = tests only).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_DIR=/app/models
EMBEDDING_BATCH_SIZE=16
