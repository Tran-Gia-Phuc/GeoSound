# =========================================================
# GeoSound — biến môi trường mẫu. Copy thành `.env` rồi điền.
# KHÔNG commit file .env thật (đã nằm trong .gitignore).
# =========================================================

NODE_ENV=development

# ---------- Ports ----------
GATEWAY_PORT=8080
AUTH_PORT=3001
TOUR_PORT=3002
MODERATION_PORT=3003
# media & notification là worker, không mở port

# ---------- Service URLs (gateway dùng để route nội bộ) ----------
AUTH_SERVICE_URL=http://auth:3001
TOUR_SERVICE_URL=http://tour:3002
MODERATION_SERVICE_URL=http://moderation:3003

# ---------- PostgreSQL ----------
# DEV LOCAL: dùng container postgis bên dưới.
# TEAM/STAGING: thay bằng connection string Supabase.
POSTGRES_USER=geosound
POSTGRES_PASSWORD=geosound
POSTGRES_DB=geosound
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma connection — MỖI SERVICE 1 schema riêng (schema-per-service).
# Khi trỏ Supabase: đổi host/user/pass/db, giữ nguyên ?schema=<ten>.
DATABASE_URL_AUTH=postgresql://geosound:geosound@postgres:5432/geosound?schema=auth
DATABASE_URL_TOUR=postgresql://geosound:geosound@postgres:5432/geosound?schema=tour
DATABASE_URL_MODERATION=postgresql://geosound:geosound@postgres:5432/geosound?schema=moderation
DATABASE_URL_MEDIA=postgresql://geosound:geosound@postgres:5432/geosound?schema=media
DATABASE_URL_NOTIFICATION=postgresql://geosound:geosound@postgres:5432/geosound?schema=notification

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=geosound.events

# ---------- JWT (Auth tự làm) ----------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Auth policy (UC01) ----------
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5      # sai mật khẩu đủ số lần này -> tạm khóa
LOGIN_LOCK_MINUTES=15     # thời gian tạm khóa

# ---------- OTP qua email (Nodemailer) ----------
OTP_TTL_SECONDS=120
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeoSound <no-reply@geosound.app>"

# ---------- AWS S3 (ảnh / audio người thật / audio TTS) ----------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=geosound-media

# ---------- AI service (Gemini, dự phòng Groq): kiểm duyệt + DỊCH tour (UC12) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
# Tour service gọi AI service để dịch bản thuyết minh. Mặc định: có GEMINI_API_KEY
# thì dịch thật (ai), không thì giữ nguyên văn bản (echo) và ngôn ngữ phụ chưa dịch
# sẽ KHÔNG hiện cho khách. Ép chế độ: TRANSLATOR=ai | echo.
AI_SERVICE_URL=http://ai:3004
TRANSLATOR=

# ---------- Google Cloud TTS + Translate ----------
# Trỏ tới file JSON service account, hoặc dùng API key tùy cấu hình.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ---------- Client (React PWA) ----------
VITE_API_BASE_URL=http://localhost:8080
