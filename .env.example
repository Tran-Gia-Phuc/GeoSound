# =========================================================
# GeoSound — biến môi trường mẫu. Copy thành `.env` rồi điền.
# KHÔNG commit file .env thật (đã nằm trong .gitignore).
# =========================================================

NODE_ENV=development

# ---------- Ports ----------
GATEWAY_PORT=8080
AUTH_PORT=3001
TOUR_PORT=3002
MODERATION_PORT=3003
# media & notification là worker, không mở port

# ---------- Service URLs (gateway dùng để route nội bộ) ----------
AUTH_SERVICE_URL=http://auth:3001
TOUR_SERVICE_URL=http://tour:3002
MODERATION_SERVICE_URL=http://moderation:3003

# ---------- PostgreSQL ----------
# DEV LOCAL: dùng container postgis bên dưới.
# TEAM/STAGING: thay bằng connection string Supabase.
POSTGRES_USER=geosound
POSTGRES_PASSWORD=geosound
POSTGRES_DB=geosound
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma connection — MỖI SERVICE 1 schema riêng (schema-per-service).
# Khi trỏ Supabase: đổi host/user/pass/db, giữ nguyên ?schema=<ten>.
DATABASE_URL_AUTH=postgresql://geosound:geosound@postgres:5432/geosound?schema=auth
DATABASE_URL_TOUR=postgresql://geosound:geosound@postgres:5432/geosound?schema=tour
DATABASE_URL_MODERATION=postgresql://geosound:geosound@postgres:5432/geosound?schema=moderation
# On Supabase every service (moderation included) uses the transaction pooler (6543, pgbouncer=true) at runtime and
# DATABASE_URL_DIRECT_<SERVICE> (session pooler 5432, same ?schema=) for prisma db push, e.g. DATABASE_URL_DIRECT_MODERATION.
# AI chatbot index (schema ai, pgvector; Supabase only, the local postgres has no pgvector). Empty = chatbot runs
# with an empty retriever. Supabase: transaction pooler 6543 with pgbouncer=true&schema=ai; DIRECT: session pooler 5432.
DATABASE_URL_AI=
DATABASE_URL_DIRECT_AI=
DATABASE_URL_MEDIA=postgresql://geosound:geosound@postgres:5432/geosound?schema=media
DATABASE_URL_NOTIFICATION=postgresql://geosound:geosound@postgres:5432/geosound?schema=notification

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=geosound.events

# ---------- JWT (Auth tự làm) ----------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Auth policy (UC01) ----------
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5      # sai mật khẩu đủ số lần này -> tạm khóa
LOGIN_LOCK_MINUTES=15     # thời gian tạm khóa

# ---------- OTP qua email (Nodemailer) ----------
OTP_TTL_SECONDS=120
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GeoSound <no-reply@geosound.app>"

# ---------- Lưu ảnh / audio tải lên (media service) ----------
# Supabase Storage (D3): tạo bucket PUBLIC rồi điền 3 biến dưới. Để trống thì
# media service lưu vào ổ đĩa (volume mediadata) và phục vụ qua
# MEDIA_PUBLIC_BASE_URL (URL trình duyệt thấy được, qua gateway).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=geosound-media
MEDIA_SERVICE_URL=http://media:3005
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/media/files

# ---------- Tìm địa chỉ (gateway → Nominatim/OpenStreetMap) ----------
# User-Agent định danh ứng dụng theo điều khoản Nominatim (để trống = mặc định).
GEOCODER_USER_AGENT=

# ---------- AWS S3 (ảnh / audio người thật / audio TTS) ----------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=geosound-media

# ---------- AI service (Gemini, dự phòng Groq): kiểm duyệt + DỊCH tour (UC12) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
# Tour service gọi AI service để dịch bản thuyết minh. Mặc định: có GEMINI_API_KEY
# thì dịch thật (ai), không thì giữ nguyên văn bản (echo) và ngôn ngữ phụ chưa dịch
# sẽ KHÔNG hiện cho khách. Ép chế độ: TRANSLATOR=ai | echo.
AI_SERVICE_URL=http://ai:3004
TRANSLATOR=
# Tour publishes place/tour submitted events and waits for AI results.
# false = direct publish as today.
MODERATION_EVENTS_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=10
MODERATION_REJECT_THRESHOLD=0.8
MODERATION_WARNING_THRESHOLD=0.4
MODERATION_TIMEOUT_SECONDS=30
MODERATION_MAX_CONCURRENCY=2
# Shared secret Moderation -> AI (header x-internal-token). Set a long random value.
INTERNAL_SERVICE_TOKEN=
# Phase 2: comma-separated image hosts; empty = host of SUPABASE_URL.
IMAGE_ALLOWED_HOSTS=
# Max bytes per image (3 MB) and total fetch time per image, in seconds.
IMAGE_MAX_BYTES=3145728
IMAGE_FETCH_TIMEOUT_SECONDS=10
# Optional LangSmith tracing of moderation calls.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=geosound-ai
# Chatbot: user turns kept per session and sent to the LLM.
CHAT_MEMORY_TURNS=6
# Chatbot indexer (consumes tour.published / tour.unpublished). Off by default.
CHATBOT_INDEXER_ENABLED=false
# Chat API (/chat, /chat/history). Off by default: both routes answer 404.
CHATBOT_ENABLED=false
# LLM-backed chat turns per minute on Gemini across all users; overflow runs on Groq (429 without GROQ_API_KEY).
CHAT_GLOBAL_RATE_LIMIT_PER_MIN=2
# Idle chat sessions are deleted after this many hours.
CHAT_SESSION_TTL_HOURS=24
CHAT_MESSAGE_MAX_CHARS=1000
# Chatbot embeddings: local = ONNX multilingual-e5-small baked into the image (fake = tests only).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_CACHE_DIR=/app/models
EMBEDDING_BATCH_SIZE=16

# ---------- Moderation service (gọi AI qua HTTP, retry, sweeper) ----------
AI_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY_MS=2000
MODERATION_PREFETCH=2
RETRY_SWEEP_INTERVAL_MS=60000
RETRY_FAILED_AFTER_MS=300000
RETRY_STALE_AFTER_MS=300000
RETRY_SWEEP_BATCH_SIZE=10
# Geo rules (metres), limits per tour type.
GEO_LEG_MAX_M_WALKING=3000
GEO_LEG_MAX_M_CYCLING=15000
GEO_LEG_MAX_M_DRIVING=100000
GEO_SPREAD_MAX_M_WALKING=10000
GEO_SPREAD_MAX_M_CYCLING=40000
GEO_SPREAD_MAX_M_DRIVING=200000
GEO_DUPLICATE_MIN_M=10
GEO_DURATION_FACTOR=2
GEO_ZIGZAG_FACTOR=1.8

# ---------- Google Cloud TTS + Translate ----------
# Trỏ tới file JSON service account, hoặc dùng API key tùy cấu hình.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# ---------- Client (React PWA) ----------
VITE_API_BASE_URL=http://localhost:8080
