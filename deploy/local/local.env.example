# Laptop k3s only: input of scripts/deploy/seal-secrets.sh for the throwaway cluster of
# docs/04-guides/k3s-cluster.md (part B, a laptop cluster). Every value is a dummy for the local stand-ins
# (deploy/local/postgres.yaml, the chart's RabbitMQ and Redis). Copy it outside the repo, or to
# .env.local-k3s (git ignores .env.*). A real environment gets its own file with real values and
# new random secrets, kept only on the admin's machine.

# Stand-in Postgres (user test, password test, database geosound), one schema per service.
DATABASE_URL_AUTH=postgresql://test:test@postgres:5432/geosound?schema=auth
DATABASE_URL_TOUR=postgresql://test:test@postgres:5432/geosound?schema=tour
DATABASE_URL_MODERATION=postgresql://test:test@postgres:5432/geosound?schema=moderation
DATABASE_URL_NOTIFICATION=postgresql://test:test@postgres:5432/geosound?schema=notification
DATABASE_URL_MEDIA=postgresql://test:test@postgres:5432/geosound?schema=media
DATABASE_URL_AI=postgresql://test:test@postgres:5432/geosound?schema=ai
DATABASE_URL_DIRECT_AI=postgresql://test:test@postgres:5432/geosound?schema=ai

JWT_ACCESS_SECRET=local-access-secret-not-real
JWT_REFRESH_SECRET=local-refresh-secret-not-real
STATS_ACTOR_SALT=local-salt
INTERNAL_SERVICE_TOKEN=local-internal-token

# The chart's RabbitMQ; RABBITMQ_URL and REDIS_URL are built from these by the script.
RABBITMQ_DEFAULT_USER=geosound
RABBITMQ_DEFAULT_PASS=local-broker-pass

# Empty: moderation uses the AI stub; translation and the chatbot answer with an error.
GEMINI_API_KEY=
GROQ_API_KEY=

# media stops at start without these; uploads fail, everything else works.
SUPABASE_URL=https://example.invalid
SUPABASE_SERVICE_ROLE_KEY=local-not-real
SUPABASE_STORAGE_BUCKET=geosound-media

# No SMTP: auth prints the OTP codes to its log (staging values make geosound-smtp optional).
