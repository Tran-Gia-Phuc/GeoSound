{
  "name": "geosound",
  "version": "0.1.0",
  "private": true,
  "description": "GeoSound — app audio guide du lịch theo GPS (monorepo).",
  "workspaces": [
    "gateway",
    "services/*",
    "shared",
    "client"
  ],
  "scripts": {
    "up": "docker compose up -d",
    "up:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "down": "docker compose down",
    "logs": "docker compose logs -f"
  }
}
